{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-factory/schemas/registry.schema.json",
  "title": "Library registry (registry.json)",
  "type": "object",
  "required": ["formatVersion", "libraries"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "libraries": {
      "type": "array", "maxItems": 256,
      "items": {
        "type": "object", "required": ["id", "source"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "source": { "type": "string", "minLength": 1, "maxLength": 400, "description": "owner/repo@ref (GitHub) or an absolute/relative local path (prefix path: optional)" },
          "note": { "type": "string", "maxLength": 300 }
        }
      }
    }
  }
}
