{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-factory/schemas/library.schema.json",
  "title": "Asset library manifest (library.json)",
  "type": "object",
  "required": ["formatVersion", "name", "version", "license", "description", "tags", "assetTypes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 1000 },
    "tags": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9:._-]{0,63}$" } },
    "assetTypes": { "type": "array", "minItems": 1, "items": { "enum": ["sprite", "character", "tileset", "sfx", "song", "fx", "font", "level", "doc", "code-kit"] } },
    "authors": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 120 } },
    "homepage": { "type": "string", "maxLength": 300 },
    "repository": { "type": "string", "maxLength": 300 }
  }
}
